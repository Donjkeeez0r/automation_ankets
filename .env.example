POSTGRES_USER=anketa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anketa

JWT_SECRET=change-me-to-a-long-random-string

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=user@example.com

FRONTEND_URL=http://localhost

# Первый администратор: создаётся при `prisma db seed` (запускается при старте
# backend-контейнера), только если в базе ещё нет ни одного ADMIN.
# Если не заданы — шаг пропускается с предупреждением.
# Seed выполняется при каждом старте контейнера: если в базе не останется ни
# одного ADMIN, администратор будет создан заново с этим паролем.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
