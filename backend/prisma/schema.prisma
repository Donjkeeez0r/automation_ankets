generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  AUDITOR
}

enum Status {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  REVISION
  FAILED
}

enum ContactorStatus {
  GREEN
  YELLOW
  RED
  NONE
}

model User {
  id                        String            @id @default(uuid())
  email                     String            @unique
  password                  String
  role                      Role              @default(EMPLOYEE)
  name                      String
  organization              String
  createdAt                 DateTime          @default(now())

  employeeQuestionnaires    Questionnaire[]   @relation("EmployeeQuestionnaires")
}

model Company {
  id                    String                @id @default(uuid())
  name                  String
  inn                   String?
  contactName           String
  contactEmails         String[]
  createdAt             DateTime              @default(now())
  status                ContactorStatus       @default(NONE)

  questionnaires        Questionnaire[]

  employees             ContactorEmployee[]
}

model ContactorEmployee {
  id                    String                @id @default(uuid())
  name                  String         
  position              String?
  email                 String?
  createdAt             DateTime              @default(now())

  companyId             String
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  filledQuestionnaires  Questionnaire[]
}

model Questionnaire {
  id                  String                @id @default(uuid())
  status              Status                @default(DRAFT)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt()
  comment             String?
  deadlineAt          DateTime?
  deadlineNotifiedAt  DateTime?

  companyId           String
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId          String
  employee            User                  @relation("EmployeeQuestionnaires", fields: [employeeId], references: [id], onDelete: Cascade)

  answers             Answer[]
  scoring             ScoringResult?

  overrides           QuestionOverride[]

  links               QuestionnaireLink[]

  artifacts           Artifact[]

  filledByEmployeeId  String?
  filledByEmployee    ContactorEmployee?    @relation(fields: [filledByEmployeeId], references: [id], onDelete: SetNull)
}

model Artifact {
  id                  String          @id @default(uuid())
  fileName            String
  storedPath          String
  mimeType            String
  size                Int
  uploadedAt          DateTime        @default(now())
  type                String          @default("regular")

  questionnaireId     String
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  questionId          String?
  question            Question?       @relation(fields: [questionId], references: [id], onDelete: SetNull)
}

model QuestionOverride {
  id                  String          @id @default(uuid())
  required            Boolean

  questionnaireId     String
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  questionId          String
  question            Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, questionId])
}

model QuestionnaireLink {
  id                  String          @id @default(uuid())
  token               String          @unique
  expiresAt           DateTime
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())

  questionnaireId     String
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}

model Question {
  id                  String          @id @default(uuid())
  code                String          @unique
  section             String
  text                String
  type                String
  order               Int
  required            Boolean         @default(true)

  answers             Answer[]

  overrides           QuestionOverride[]

  artifacts           Artifact[]
}

model Answer {
  id                  String          @id @default(uuid())
  value               String
  additionalValue     String?

  questionId          String
  question            Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  questionnaireId     String
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, questionId])
}

model ScoringResult {
  id                  String          @id @default(uuid())
  recommended         Boolean         @default(false)
  
  auditScore          Int
  documentScore       Int
  measuresScore       Int
  
  gisScore            Int?
  pdnScore            Int?
  remoteAccessScore   Int?
  devScore            Int?
  contractorsScore    Int?

  questionnaireId     String          @unique
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}