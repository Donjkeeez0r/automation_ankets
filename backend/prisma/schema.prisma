generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  AUDITOR
}

enum Status {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  REVISION
  FAILED
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  password            String
  role                Role            @default(EMPLOYEE)
  name                String
  organization        String
  createdAt           DateTime        @default(now())

  employeeQuestionnaires    Questionnaire[]  @relation("EmployeeQuestionnaires")
}

model Company {
  id                    String        @id @default(uuid())
  name                  String
  inn                   String?
  contactName           String
  contactEmail          String
  createdAt             DateTime      @default(now())

  questionnaires  Questionnaire[]
}

model Questionnaire {
  id                  String          @id @default(uuid())
  status              Status          @default(DRAFT)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt()
  comment             String?
  deadlineAt          DateTime?
  deadlineNotifiedAt  DateTime?

  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId          String
  employee            User            @relation("EmployeeQuestionnaires", fields: [employeeId], references: [id], onDelete: Cascade)

  answers             Answer[]
  scoring             ScoringResult?

  links               QuestionnaireLink[]
}

model QuestionnaireLink {
  id                  String          @id @default(uuid())
  token               String          @unique
  expiresAt           DateTime
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())

  questionnaireId     String
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}

model Question {
  id                  String          @id @default(uuid())
  code                String          @unique
  section             String
  text                String
  type                String
  order               Int

  answers             Answer[]
}

model Answer {
  id                  String          @id @default(uuid())
  value               String
  additionalValue     String?

  questionId          String
  question            Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  questionnaireId     String
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, questionId])
}

model ScoringResult {
  id                  String          @id @default(uuid())
  recommended         Boolean         @default(false)
  
  auditScore          Int
  documentScore       Int
  measuresScore       Int
  
  gisScore            Int?
  pdnScore            Int?
  remoteAccessScore   Int?
  devScore            Int?
  contractorsScore    Int?

  questionnaireId     String          @unique
  questionnaire       Questionnaire   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}