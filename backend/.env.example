# Локальный запуск backend (pnpm start:dev, pnpm prisma db seed)

DATABASE_URL=postgresql://anketa:change-me@localhost:5433/anketa?schema=public
JWT_SECRET=change-me-to-a-long-random-string

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=user@example.com

FRONTEND_URL=http://localhost:5173

# Первый администратор: создаётся при `pnpm prisma db seed`, только если
# в базе ещё нет ни одного ADMIN. Если не заданы — шаг пропускается.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
